#
# Please avoid changing the Exynos defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#

# WLBT platform
CONFIG_SCSC_WLBT_CONFIG_PLATFORM="leman_s620_troika_dualfem"

# Regulator
CONFIG_REGULATOR_S2MPU09_BUCK8_1V35=y

# Camera sensors (CIS)
CONFIG_CAMERA_CIS_12A10_OBJ=y
CONFIG_CAMERA_CIS_12A10FF_OBJ=y
CONFIG_CAMERA_CIS_16885C_OBJ=y

# Camera actuator
CONFIG_CAMERA_ACT_LC898217_OBJ=y

# Camera EEPROM
CONFIG_CAMERA_EEPROM_12A10_OBJ=y
CONFIG_CAMERA_EEPROM_12A10FF_OBJ=y
CONFIG_CAMERA_EEPROM_16885C_OBJ=y

# Droidspaces legacy-kernel container runtime support.
# Required for namespace, cgroup, OverlayFS and NAT/veth container modes.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_NAT_IPV4=y

# SukiSU Ultra built-in (manual-hook) integration. SUSFS is deliberately
# disabled: this kernel ships root support, not root-hiding hooks. KPM stays
# disabled because Linux 4.14 lacks the set_memory API it requires.
CONFIG_KSU=y
# CONFIG_KSU_SUSFS is not set
# CONFIG_KPM is not set

# Custom hostname and kernel identity for Troika Mint BORE+ADIOS builds
CONFIG_DEFAULT_HOSTNAME="troika-mint"

# Consumer-performance configuration.  The SLUB setting follows the Exynos
# 9610 Mint kernel's low-latency configuration; scheduler statistics are for
# debugging and add accounting work to hot scheduling paths.
# CONFIG_SLUB_CPU_PARTIAL is not set
# CONFIG_SCHEDSTATS is not set

# BORE CPU scheduler backport (CONFIG_SCHED_BORE) — burst-oriented
# response enhancer that boosts latency-sensitive tasks when CPU-bound
# tasks build up runtime history.
CONFIG_SCHED_BORE=y

CONFIG_DEFAULT_IOSCHED="mq-deadline"

# ZRAM compression: zstd and lz4 modules are built-in. Default is
# lzo (stock kernel default) for maximum compatibility; users can
# switch at runtime:
#   echo lz4 | sudo tee /sys/block/zram0/comp_algorithm
#   echo zstd | sudo tee /sys/block/zram0/comp_algorithm
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

# LTO (Link-Time Optimisation) re-enabled now that the build host has
# 16GB of swap available.  ThinLTO is used (not full LTO) because it
# links in ~1/3 the memory and ~2x the speed, with very similar
# runtime performance.  ThinLTO requires Clang LLD.
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_ARCH_SUPPORTS_LTO_CLANG=y
CONFIG_ARCH_SUPPORTS_THINLTO=y
